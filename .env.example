# ══════════════════════════════════════════════════════════════════════════════
# FLEXISCHEDULER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git!
# ══════════════════════════════════════════════════════════════════════════════

# Supabase Database & Backend
# (Obtain from: Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Twilio Credentials (WhatsApp & SMS Incident Dispatch)
# (Obtain from: console.twilio.com -> Dashboard)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Maintenance Team Incident Target
VITE_RECIPIENT_PHONE=+91xxxxxxxxxx
VITE_WHATSAPP_SANDBOX_CODE=your-sandbox-code
